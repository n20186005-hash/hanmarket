---
import { market, text, type Language } from "../data/content";
import WeatherSection from "./WeatherSection.astro";
const { lang } = Astro.props as { lang: Language };
const c = text[lang];
const vi = lang === "vi";
const ids = vi ? { hours: "gio-mo-cua", explore: "kham-pha", getting: "di-chuyen", map: "ban-do" } : { hours: "opening-hours", explore: "explore", getting: "getting-here", map: "map" };
---
<section class="hero" aria-labelledby="hero-title">
 <img class="hero-photo" src="/images/han-market-overview.jpg" alt={vi ? "Ảnh tư liệu bên trong Chợ Hàn năm 2014" : "Historical photograph inside Han Market in 2014"} width="1280" height="853" fetchpriority="high" />
 <div class="wrap"><div class="hero-copy"><p class="eyebrow">{c.hero.eyebrow}</p><h1 class="display" id="hero-title">{c.hero.title}</h1><p class="hero-lead">{c.hero.lead}</p><div class="hero-actions"><a class="btn btn-primary" href={`#${ids.hours}`}>{c.hero.primary}</a><a class="btn btn-outline" href={`#${ids.map}`}>{c.hero.secondary}</a></div></div></div><div class="hero-fact">{c.hero.fact}</div>
</section>
<section class="quick-band" aria-label={vi ? "Thông tin nhanh" : "At a glance"}><div class="wrap quick-grid"><div class="quick-item"><span>{vi ? "Địa chỉ" : "Address"}</span><strong>119 Trần Phú</strong></div><div class="quick-item"><span>{vi ? "Giờ theo nguồn du lịch" : "Published tourism hours"}</span><strong><a href={`#${ids.hours}`}>06:00–19:00*</a></strong></div><div class="quick-item"><span>{vi ? "Định vị" : "Location"}</span><strong><a href={market.mapsShareUrl} rel="noopener noreferrer" target="_blank">Google Maps ↗</a></strong></div><div class="quick-item"><span>{vi ? "Trước khi mua" : "Before buying"}</span><strong>{vi ? "Hỏi giá & đơn vị tính" : "Confirm price & unit"}</strong></div></div></section>
<section class="rail-section" id={ids.hours} aria-labelledby="hours-title"><div class="wrap intro-grid"><div><p class="eyebrow">{vi ? "01 · Lập kế hoạch" : "01 · Plan your visit"}</p><h2 class="display section-title" id="hours-title">{c.hours.title}</h2></div><div class="section-text"><p>{c.hours.body}</p><p><a href={market.govTourismUrl} target="_blank" rel="noopener noreferrer">{vi ? "Nguồn: Cổng du lịch thành phố Đà Nẵng, 09/10/2023 ↗" : "Source: Da Nang city tourism portal, 9 October 2023 ↗"}</a></p><aside class="info-ticket"><strong>Google Maps · 23/10/2026</strong><p>{c.hours.snapshot}</p><a href={market.mapsShareUrl} target="_blank" rel="noopener noreferrer">{vi ? "Xem hồ sơ hiện tại ↗" : "Open the current listing ↗"}</a></aside></div></div></section>
<section class="journey" id={ids.explore} aria-labelledby="shopping-title"><div class="wrap"><div class="journey-header"><h2 class="display section-title" id="shopping-title">{c.shopping.title}</h2><p>{c.shopping.intro}</p></div><div class="step-list">{c.shopping.cards.map(([title, body],i)=><article class="step"><span class="step-no">0{i+1}</span><h3>{title}</h3><p>{body}</p></article>)}</div></div></section>
<section class="photo-slice" aria-label={vi ? "Ảnh tư liệu chợ" : "Historical market photograph"}><img src="/images/han-market-vegetables.jpg" alt={vi ? "Hàng nông sản ở Chợ Hàn năm 2014" : "Produce at Han Market in 2014"} width="1280" height="853" loading="lazy" /><div class="wrap"><div class="quote-box"><p>{vi ? "Đi chậm, hỏi rõ và nhường lối cho người mua bán." : "Take your time, ask clearly and leave room for trade."}</p><span>Daderot · 2014 · CC0 · <a href="#photo-credits">{vi ? "Nguồn ảnh" : "Photo credits"}</a></span></div></div></section>
<section class="practical" aria-labelledby="practical-title"><div class="wrap"><div class="practical-top"><h2 class="display section-title" id="practical-title">{c.practical.title}</h2></div><div class="practical-list">{c.practical.rows.map(([title, body],i)=><article class="practical-row"><h3>{title}</h3><p>{body}</p><span class="index">0{i+1}</span></article>)}</div></div></section>
<section class="access" id={ids.getting} aria-labelledby="transport-title"><div class="wrap"><h2 class="display" id="transport-title">{c.transport.title}</h2><p>{c.transport.intro}</p><div class="transport-grid">{c.transport.cards.map(([title,body],i)=><article class="transport-card"><span class="tiny">0{i+1}</span><h3>{title}</h3><p>{body}</p></article>)}</div></div></section>
<section class="map-section" id={ids.map} aria-labelledby="map-title"><div class="wrap map-layout"><div><p class="eyebrow">{vi ? "Điểm chợ · không phải vị trí máy ảnh" : "Market pin · location reference"}</p><h2 class="display section-title" id="map-title">{vi ? "Tìm Chợ Hàn trên bản đồ" : "Find Han Market on the map"}</h2><div class="map-address"><strong>{vi ? "Địa chỉ" : "Address"}</strong><p>{market.address}</p></div><p><a class="btn btn-primary" href={market.mapsShareUrl} target="_blank" rel="noopener noreferrer">{vi ? "Mở chỉ đường Google Maps ↗" : "Open Google Maps directions ↗"}</a></p><p>{vi ? "Ưu tiên biển báo và chỉ dẫn tại chỗ. Bản đồ Google có chính sách riêng." : "Follow signs and directions on arrival. Google’s policies apply to its map."}</p></div><div class="map-frame"><iframe title={vi ? "Bản đồ vị trí Chợ Hàn" : "Han Market location map"} src="https://www.google.com/maps?q=16.0680836,108.224069&z=17&output=embed" loading="lazy" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe></div></div></section>
<WeatherSection lang={lang} />
<section class="faq" id="faq" aria-labelledby="faq-title"><div class="wrap faq-layout"><div><p class="eyebrow">{c.faq.eyebrow}</p><h2 class="display section-title" id="faq-title">{c.faq.title}</h2></div><div class="faq-list">{c.faq.items.map(([question,answer])=><details><summary>{question}</summary><p>{answer}</p></details>)}</div></div></section>
