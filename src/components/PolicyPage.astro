---
import CookiePreferences from "./CookiePreferences.astro";
import type { Language } from "../data/content";
const {lang,kind} = Astro.props as {lang:Language;kind:"privacy"|"terms"|"cookies"};
const values = {
  "vi": {
    "privacy": {
      "title": "Chính sách riêng tư",
      "sections": [
        [
          "Phạm vi",
          "Đây là cẩm nang du lịch độc lập của bên thứ ba. Trang không có biểu mẫu liên hệ, tài khoản người dùng hoặc chức năng đặt hàng."
        ],
        [
          "Hạ tầng & dịch vụ bên ngoài",
          "Cloudflare cung cấp hạ tầng website. Bản đồ nhúng Google Maps và phông chữ Google Fonts có thể nhận địa chỉ IP, thông tin trình duyệt và dữ liệu yêu cầu khi được tải, kể cả khi phân tích bị tắt."
        ],
        [
          "Google Analytics tùy chọn",
          "Google Analytics (G-HXM22WWPKP) chỉ tải sau khi bạn bật phân tích. Dịch vụ có thể xử lý định danh cookie và dữ liệu sử dụng; không nên coi dữ liệu này là hoàn toàn ẩn danh. Bạn có thể từ chối hoặc rút lựa chọn trên trang tùy chọn phân tích."
        ],
        [
          "Bộ nhớ trên thiết bị",
          "Lựa chọn phân tích được lưu bằng localStorage. Khi rút lựa chọn, trang tắt đo lường tiếp theo và xóa cookie Analytics có thể truy cập ở đường dẫn gốc; thao tác này không xóa dữ liệu đã gửi trước đó. Service worker lưu đệm ảnh và biểu tượng, không lưu API thời tiết hoặc trang điều hướng."
        ]
      ]
    },
    "terms": {
      "title": "Điều khoản sử dụng",
      "sections": [
        [
          "Mục đích",
          "Cẩm nang cung cấp thông tin tham khảo, không phải thông báo của ban quản lý Chợ Hàn hoặc cơ quan du lịch."
        ],
        [
          "Xác minh trước chuyến đi",
          "Giờ tham khảo được ghi kèm nguồn và ngày. Giờ quầy, giá, giao thông và tiện ích có thể thay đổi. Dùng thông báo tại chợ hoặc nhà cung cấp để xác minh các chi tiết quan trọng."
        ],
        [
          "Thời tiết & liên kết",
          "Dự báo thời tiết là dữ liệu mô hình, không phải cảnh báo khẩn cấp hoặc xác nhận đóng mở chợ. Liên kết bên ngoài có điều khoản và chính sách riêng."
        ],
        [
          "Ảnh & nội dung",
          "Nguồn, tác giả và giấy phép từng ảnh được ghi ở chân trang. Các ảnh Daderot được cung cấp theo CC0 1.0; xem bản gốc và điều khoản giấy phép trước khi dùng lại."
        ]
      ]
    },
    "cookies": {
      "title": "Tùy chọn phân tích",
      "sections": [
        [
          "Lựa chọn trên thiết bị này",
          "Phân tích tắt cho đến khi bạn bật. Lựa chọn áp dụng cho trình duyệt này; nếu xóa bộ nhớ hoặc dùng thiết bị khác, bạn cần chọn lại. Không có tùy chọn ngôn ngữ được lưu."
        ],
        [
          "Rút lựa chọn",
          "Bỏ chọn phân tích rồi lưu, hoặc dùng nút từ chối. Rút lựa chọn tắt đo lường tiếp theo nhưng không xóa dữ liệu đã gửi. Lựa chọn phân tích không tắt bản đồ Google hoặc phông chữ bên ngoài."
        ]
      ]
    }
  },
  "en": {
    "privacy": {
      "title": "Privacy policy",
      "sections": [
        [
          "Scope",
          "This independent third-party visitor guide has no contact form, user accounts or ordering function."
        ],
        [
          "Infrastructure & external services",
          "Cloudflare hosts the site. Embedded Google Maps and Google Fonts may receive your IP address, browser information and request data when loaded, including when analytics is off."
        ],
        [
          "Optional Google Analytics",
          "Google Analytics (G-HXM22WWPKP) loads after you enable analytics. It may process cookie identifiers and usage information; this should not be described as fully anonymous. Reject or withdraw your choice on the analytics settings page."
        ],
        [
          "Device storage",
          "Your analytics choice is stored in localStorage. Withdrawal disables further measurement and clears accessible Analytics cookies at the root path; it does not erase data already sent. The service worker caches images and icons, rather than weather API responses or page navigations."
        ]
      ]
    },
    "terms": {
      "title": "Terms of use",
      "sections": [
        [
          "Purpose",
          "This guide provides visitor information, rather than notices issued by Han Market management or the tourism authority."
        ],
        [
          "Check before travelling",
          "Reference hours are accompanied by their source and date. Stall schedules, prices, transport and facilities can change. Confirm important details through notices at the market or with the relevant provider."
        ],
        [
          "Weather & links",
          "Weather is model data, rather than an emergency warning or confirmation of market closures. External links have their own terms and policies."
        ],
        [
          "Photographs & content",
          "The footer identifies each photograph’s source, author and licence. Daderot’s photographs are provided under CC0 1.0; consult the originals and licence terms when reusing them."
        ]
      ]
    },
    "cookies": {
      "title": "Analytics settings",
      "sections": [
        [
          "Your choice on this device",
          "Analytics is off until you enable it. The choice applies to this browser; clearing storage or using another device requires a new choice. No language preference is stored."
        ],
        [
          "Withdrawing",
          "Uncheck analytics and save, or use Reject analytics. Withdrawal disables further measurement but does not erase data already sent. The analytics choice does not disable Google Maps or external fonts."
        ]
      ]
    }
  }
} as const;
const page = values[lang][kind];
---
<section class="policy-hero"><div class="wrap"><p class="eyebrow">{lang === "vi" ? "Thông tin website" : "Website information"}</p><h1 class="display">{page.title}</h1></div></section>
<article class="wrap policy-body"><aside class="policy-aside">{lang === "vi" ? "Cập nhật: 23/10/2026" : "Updated: 23 October 2026"}</aside><div class="policy-content">{page.sections.map(([heading,body])=><section><h2>{heading}</h2><p>{body}</p></section>)}{(kind === "privacy" || kind === "cookies") && <section><h2>Cloudflare Web Analytics (RUM)</h2><p>{lang === "vi" ? "Hạ tầng website có beacon hiệu năng Cloudflare, độc lập với Google Analytics. Lựa chọn phân tích ở đây chỉ điều khiển tích hợp Google Analytics của trang, không điều khiển beacon của hạ tầng. Việc có mã script không xác nhận rằng dữ liệu đo lường đã được gửi trong một lượt truy cập cụ thể." : "The hosting service includes a Cloudflare performance beacon, separate from Google Analytics. This analytics choice controls the site’s Google Analytics integration, not the hosting beacon. The presence of its script does not confirm that metrics were sent during a particular visit."} <a href="https://developers.cloudflare.com/web-analytics/data-metrics/data-origin-and-collection/">{lang === "vi" ? "Tài liệu Cloudflare về thu thập dữ liệu" : "Cloudflare documentation on data collection"}</a>.</p></section>}<p><a href={lang === "vi" ? "/tuy-chon-cookie/" : "/en/cookie-settings/"}>{lang === "vi" ? "Quản lý phân tích" : "Manage analytics"}</a> · <a href="https://policies.google.com/privacy" rel="noopener noreferrer" target="_blank">Google Privacy</a> · <a href="https://www.cloudflare.com/privacypolicy/" rel="noopener noreferrer" target="_blank">Cloudflare Privacy</a></p>{kind === "cookies" && <CookiePreferences lang={lang} />}</div></article>
