---
// River-market editorial style: privacy controls stay direct and legible, using the same paper-and-ink material language as the guide.
import type { Language } from "../data/content";
const { lang } = Astro.props as { lang: Language };
const isVi = lang === "vi";
const labels = isVi ? {
  required: "Lựa chọn lưu cục bộ", requiredText: "Trang dùng bộ nhớ cục bộ để ghi lựa chọn phân tích, không lưu tùy chọn ngôn ngữ.", analytics: "Cookie phân tích", analyticsText: "Cho phép Google Analytics thu thập dữ liệu về việc sử dụng trang để hiểu cách mọi người dùng cẩm nang.", save: "Lưu tùy chọn", reject: "Từ chối phân tích", done: "Tùy chọn của bạn đã được lưu trên thiết bị này.", active: "Luôn hoạt động"
} : {
  required: "Stored analytics choice", requiredText: "The site stores your analytics choice in local storage. No language preference is stored.", analytics: "Analytics cookies", analyticsText: "Allow Google Analytics to collect usage information so we can understand how the guide is used.", save: "Save preferences", reject: "Reject analytics", done: "Your preferences have been saved on this device.", active: "Always active"
};
---
<form class="cookie-form" data-cookie-form>
  <div class="cookie-option"><div><h3>{labels.required}</h3><p>{labels.requiredText}</p></div><span class="eyebrow">{labels.active}</span></div>
  <div class="cookie-option"><div><h3>{labels.analytics}</h3><p>{labels.analyticsText}</p></div><label class="switch"><input type="checkbox" name="analytics" /><span aria-hidden="true"></span><span class="sr-only">{labels.analytics}</span></label></div>

  <div class="cookie-actions"><button type="submit">{labels.save}</button><button class="secondary" type="button" data-reject>{labels.reject}</button></div>
  <p class="save-message" role="status" aria-live="polite"></p>
</form>
<script is:inline>
  const form = document.querySelector("[data-cookie-form]");
  const message = form?.querySelector(".save-message");
  const analytics = form?.querySelector('input[name="analytics"]');
  const saved = window.hanAnalytics?.get() ? "granted" : "denied";
  if (analytics && saved === "granted") analytics.checked = true;
  const save = (granted) => {
    const stored = window.hanAnalytics?.set(granted);
    if (analytics) analytics.checked = Boolean(window.hanAnalytics?.get());
    if (stored !== true) { if (message) message.textContent = document.documentElement.lang === "vi" ? "Phân tích đã tắt trên trang này, nhưng không thể lưu lựa chọn. Kiểm tra bộ nhớ trình duyệt và thử lại trước khi tải lại trang." : "Analytics is off for this page, but the choice could not be saved. Check browser storage and retry before reloading."; return; }
    if (message) message.textContent = document.documentElement.lang === "vi" ? "Tùy chọn của bạn đã được lưu trên thiết bị này." : "Your preferences have been saved on this device.";

  };
  form?.addEventListener("submit", (event) => { event.preventDefault(); save(Boolean(analytics?.checked)); });
  form?.querySelector("[data-reject]")?.addEventListener("click", () => { if (analytics) analytics.checked = false; save(false); });
</script>
